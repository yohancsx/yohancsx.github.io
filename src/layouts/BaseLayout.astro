---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  /** Page title. Rendered as "Title - Your Name", except on the home page. */
  title?: string;
  description?: string;
  /** Path to a social preview image in public/, e.g. "/og.png" */
  image?: string;
}

const {
  title,
  description = site.description,
  image = "/og.png",
} = Astro.props;

const pageTitle = title ? `${title} — ${site.siteName}` : site.siteName;

// Astro.site comes from `site` in astro.config.mjs. Guarding keeps dev working
// even if that value hasn't been filled in yet.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!--
      Theme init — runs before anything paints, so a returning visitor who
      chose light mode never sees a flash of dark first. `is:inline` keeps
      Astro from deferring or bundling it; it must run synchronously, here,
      in source order. This is the one script the site ships.
    -->
    <script is:inline>
      (function () {
        var KEY = "theme";
        try {
          if (localStorage.getItem(KEY) === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          /* localStorage unavailable (private mode, etc.) — default to dark. */
        }

        document.addEventListener("DOMContentLoaded", function () {
          var btn = document.querySelector("[data-theme-toggle]");
          if (btn) {
            var isLight = document.documentElement.getAttribute("data-theme") === "light";
            btn.setAttribute("aria-pressed", String(isLight));
          }
        });

        document.addEventListener("click", function (e) {
          var btn = e.target.closest("[data-theme-toggle]");
          if (!btn) return;
          var root = document.documentElement;
          var goingLight = root.getAttribute("data-theme") !== "light";
          if (goingLight) {
            root.setAttribute("data-theme", "light");
          } else {
            root.removeAttribute("data-theme");
          }
          try {
            localStorage.setItem(KEY, goingLight ? "light" : "dark");
          } catch (e) {
            /* Selection just won't persist across visits — still works this session. */
          }
          btn.setAttribute("aria-pressed", String(goingLight));
        });
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Social previews (LinkedIn, Slack, iMessage, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
