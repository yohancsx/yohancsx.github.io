---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  /** Page title. Rendered as "Title - Your Name", except on the home page. */
  title?: string;
  description?: string;
  /** Path to a social preview image in public/, e.g. "/og.png" */
  image?: string;
}

const {
  title,
  description = site.description,
  image = "/og.png",
} = Astro.props;

const pageTitle = title ? `${title} — ${site.siteName}` : site.siteName;

// Astro.site comes from `site` in astro.config.mjs. Guarding keeps dev working
// even if that value hasn't been filled in yet.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Social previews (LinkedIn, Slack, iMessage, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
