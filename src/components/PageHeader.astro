---
interface Props {
  title: string;
  intro?: string;
  /** e.g. "01" — rendered as "[ 01 ]" before the title, monospace. Optional. */
  index?: string;
}

const { title, intro, index } = Astro.props;
---

<div class="page-header">
  <h1>
    {index && <span class="page-index">[ {index} ]</span>}
    {title}
  </h1>
  {intro && <p>{intro}</p>}
</div>
