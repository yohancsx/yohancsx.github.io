---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";

const hobbyEntries = (
  await getCollection("hobbies", ({ data }) => data.published)
).sort((a, b) => a.data.order - b.data.order);

const hobbies = await Promise.all(
  hobbyEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const art = (await getCollection("art", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0),
);
---

<BaseLayout
  title="Hobbies"
  description="Art, and the other things I spend my time on."
>
  <PageHeader
    index="04"
    title="Hobbies"
    intro="What I get up to when I'm not in the lab."
  />

  {
    hobbies.length > 0 && (
      <div class="hobby-grid">
        {hobbies.map(({ entry, Content }) => (
          <section class="hobby">
            <h3>
              {entry.data.icon && <span aria-hidden="true">{entry.data.icon}</span>}
              {entry.data.title}
            </h3>
            <div class="hobby__body">
              <Content />
            </div>
            {entry.data.links.length > 0 && (
              <div class="btn-row">
                {entry.data.links.map((l) => (
                  <a class="btn" href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label}
                  </a>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    )
  }

  <h2 class="section-label">Art</h2>

  {
    art.length === 0 ? (
      <EmptyState folder="src/content/art" />
    ) : (
      <ul class="gallery">
        {art.map((piece) => (
          <li class="art">
            <Image
              src={piece.data.image}
              alt={piece.data.imageAlt}
              widths={[280, 560, 840]}
              sizes="(max-width: 560px) 92vw, 280px"
              loading="lazy"
              decoding="async"
            />
            <div class="art__caption">
              <strong>{piece.data.title}</strong>
              <span>
                {[piece.data.medium, piece.data.year].filter(Boolean).join(" · ")}
              </span>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
