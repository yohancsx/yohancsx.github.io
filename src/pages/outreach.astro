---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EntryCard from "../components/EntryCard.astro";
import type { Action } from "../components/EntryCard.astro";
import EmptyState from "../components/EmptyState.astro";

/** Maps a resource kind to the icon that best describes it. */
const RESOURCE_ICONS = {
  pdf: "pdf",
  stl: "model",
  slides: "slides",
  zip: "zip",
  link: "link",
} as const;

const entries = (await getCollection("outreach", ({ data }) => data.published))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const actions: Action[] = entry.data.resources.map((r, i) => ({
      label: r.label,
      url: r.url,
      icon: RESOURCE_ICONS[r.kind],
      primary: i === 0,
    }));
    for (const l of entry.data.links)
      actions.push({ label: l.label, url: l.url, icon: "link" });

    return { entry, Content, actions };
  }),
);
---

<BaseLayout
  title="Outreach"
  description="Science outreach events, plus free lesson plans and 3D-printable models for students and educators."
>
  <PageHeader
    title="Outreach"
    intro="Events, workshops, and teaching. Lesson plans and 3D-printable models are free to download and use in your own classroom."
  />

  {
    items.length === 0 ? (
      <EmptyState folder="src/content/outreach" />
    ) : (
      <div class="entries">
        {items.map(({ entry, Content, actions }) => (
          <EntryCard
            title={entry.data.title}
            meta={[
              fmtDate(entry.data.date),
              entry.data.venue,
              entry.data.audience,
            ]}
            image={entry.data.image}
            imageAlt={entry.data.imageAlt ?? entry.data.title}
            actions={actions}
            featured={entry.data.featured}
          >
            <Content />
          </EntryCard>
        ))}
      </div>
    )
  }
</BaseLayout>
