---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EntryCard from "../components/EntryCard.astro";
import type { Action } from "../components/EntryCard.astro";
import EmptyState from "../components/EmptyState.astro";

const entries = (await getCollection("research", ({ data }) => data.published))
  // Featured entries float to the top, then newest first.
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.year - a.data.year;
  });

// Render each Markdown body up front so the template stays declarative.
const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const actions: Action[] = [];

    if (entry.data.paper)
      actions.push({
        label: "Paper (PDF)",
        url: entry.data.paper,
        icon: "pdf",
        primary: true,
      });
    if (entry.data.slides)
      actions.push({ label: "Slides", url: entry.data.slides, icon: "slides" });
    if (entry.data.doi)
      actions.push({
        label: "DOI",
        url: `https://doi.org/${entry.data.doi.replace(/^https?:\/\/doi\.org\//, "")}`,
        icon: "link",
      });
    for (const l of entry.data.links)
      actions.push({ label: l.label, url: l.url, icon: "link" });

    return { entry, Content, actions };
  }),
);
---

<BaseLayout
  title="Research"
  description="Scientific research projects, publications, and talks."
>
  <PageHeader
    index="01"
    title="Research"
    intro="Scientific projects I've led or contributed to. Where a paper or talk is public, it's linked directly."
  />

  {
    items.length === 0 ? (
      <EmptyState folder="src/content/research" />
    ) : (
      <div class="entries">
        {items.map(({ entry, Content, actions }) => (
          <EntryCard
            title={entry.data.title}
            meta={[String(entry.data.year), entry.data.venue]}
            authors={entry.data.authors}
            image={entry.data.image}
            imageAlt={entry.data.imageAlt ?? entry.data.title}
            pills={entry.data.tags}
            actions={actions}
            featured={entry.data.featured}
          >
            <Content />
          </EntryCard>
        ))}
      </div>
    )
  }
</BaseLayout>
